.latest-card {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  color: #fff;
}

.latest-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.latest-issue {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.latest-date {
  font-size: 26rpx;
  opacity: 0.9;
}

.latest-balls {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 40rpx;
}

.latest-balls .ball-red {
  background: #fff;
  color: #e74c3c;
}

.latest-balls .ball-blue {
  background: #fff;
  color: #3498db;
}

.latest-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.history-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.history-header .issue {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.history-header .date {
  font-size: 24rpx;
  color: #999;
}

.history-balls {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.history-stats {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}