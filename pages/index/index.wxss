.banner {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  color: #fff;
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.banner-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.banner-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-header .more {
  font-size: 26rpx;
  color: #999;
}

.latest-result .result-info {
  text-align: center;
}

.latest-result .issue {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.latest-result .date {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.latest-result .balls {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.bet-icon {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
}

.check-icon {
  background: linear-gradient(135deg, #27ae60, #229954);
}

.trend-icon {
  background: linear-gradient(135deg, #3498db, #2980b9);
}

.station-icon {
  background: linear-gradient(135deg, #f39c12, #d68910);
}

.action-item text {
  font-size: 26rpx;
  color: #333;
}

.station-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.station-item:last-child {
  border-bottom: none;
}

.station-name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.station-address {
  font-size: 24rpx;
  color: #999;
}

.station-distance {
  font-size: 26rpx;
  color: #e74c3c;
}