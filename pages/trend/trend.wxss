.tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #fff;
  color: #e74c3c;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.trend-scroll {
  white-space: nowrap;
  margin-bottom: 30rpx;
}

.trend-table {
  display: inline-block;
  min-width: 100%;
}

.table-header {
  display: flex;
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  color: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-cell {
  width: 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 20rpx;
  flex-shrink: 0;
}

.header-cell.issue {
  width: 100rpx;
}

.header-cell.sum,
.header-cell.span,
.header-cell.odd-even {
  width: 80rpx;
}

.table-body {
  background: #fff;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:nth-child(even) {
  background: #fafafa;
}

.cell {
  width: 60rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 20rpx;
  color: #666;
  flex-shrink: 0;
}

.cell.issue {
  width: 100rpx;
  color: #333;
  font-weight: bold;
}

.cell.sum,
.cell.span,
.cell.odd-even {
  width: 80rpx;
  color: #e74c3c;
}

.cell.red-ball {
  background: #e74c3c;
  color: #fff;
  font-weight: bold;
  border-radius: 50%;
  margin: 5rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.stats-section {
  margin-bottom: 40rpx;
}

.stats-section:last-child {
  margin-bottom: 0;
}

.stats-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.stats-balls {
  display: flex;
  flex-wrap: wrap;
}

.stat-ball {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx 20rpx 0;
}

.stat-ball .ball {
  margin-bottom: 8rpx;
}

.stat-count {
  font-size: 22rpx;
  color: #e74c3c;
  font-weight: bold;
}