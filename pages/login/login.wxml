<view class="container">
  <view class="logo-section">
    <view class="logo"></view>
    <view class="app-name">彩票小程序</view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <input class="form-input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>
    <view class="form-item">
      <input class="form-input" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" maxlength="6" />
      <button class="code-btn" bindtap="sendCode" disabled="{{codeCountdown > 0}}">
        {{codeCountdown > 0 ? codeCountdown + 's' : '获取验证码'}}
      </button>
    </view>

    <button class="btn-primary login-btn" bindtap="login">登录</button>

    <view class="wechat-login" bindtap="wechatLogin">
      <view class="wechat-icon"></view>
      <text>微信一键登录</text>
    </view>
  </view>

  <view class="agreement">
    <text>登录即表示同意</text>
    <text class="link">《用户协议》</text>
    <text>和</text>
    <text class="link">《隐私政策》</text>
  </view>
</view>